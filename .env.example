# Copy to .env and edit. docker compose reads .env automatically.

# Your domain. Caddy gets a real Let's Encrypt cert for it automatically.
# Use "localhost" for local testing (Caddy issues a self-signed cert).
DOMAIN=secrets.example.com

# Secret lifetime (Go duration: 30m, 1h, 24h). Max units is hours, no "d".
TTL=1h

# Max number of stored secrets (load-shedding cap).
MAX_ENTRIES=5000

# Max ciphertext size per secret, in bytes (512 KiB here).
MAX_SIZE=524288
